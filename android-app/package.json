{
  "name": "jef-maker",
  "version": "1.0.0",
  "private": true,
  "description": "JEF Maker - screenshot/photo to Janome .jef embroidery file (Android app)",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.cpSync('../dist','www',{recursive:true})\"",
    "sync": "npm run copy-web && npx cap sync android",
    "open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3"
  }
}
